# Copy to .env for source development, or configure providers in Settings.
# Windows desktop is the supported user interface. No hosted account is needed.
LOCAL_DIRECT_MODE=true
ACCOUNT_CLOUD_URL=
PROVIDER_GATEWAY_REQUIRED=false
BILLING_ENABLED=false
VISION_PROVIDER=minimax
ASR_PROVIDER=volcano
ASR_REQUIRED=false

# Install FFmpeg separately; use a command on PATH or an absolute path (no quotes).
FFMPEG_PATH=ffmpeg
FRAME_RATE_FPS=5
KEEP_VIDEO=true

# Use model identifiers supported by your own provider account.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
MINIMAX_VISION_URL=https://api.minimaxi.com/v1/chat/completions
MINIMAX_VISION_MODEL=MiniMax-M3
MINIMAX_SERVICE_TIER=standard
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
VISION_BATCH_SIZE=19
VISION_BATCH_CONCURRENCY=2
VOLCANO_ASR_API_KEY=
VOLCANO_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
VOLCANO_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
VOLCANO_ASR_RESOURCE_ID=volc.seedasr.auc
VOLCANO_ASR_LANGUAGE=zh-CN
VOLCANO_ASR_POLL_INTERVAL_MS=3000
VOLCANO_ASR_TIMEOUT_MS=180000
VOLCANO_DIRECT_UPLOAD_MAX_MB=95

# Desktop uses its own Douyin login session. These settings are optional CLI fallbacks.
DOWNLOAD_RETRY_TIMES=3
DOWNLOAD_RETRY_DELAYS_MS=1000,2000,5000
DOWNLOAD_INTEGRITY_CHECK=true
DOUYIN_COOKIE=
DOUYIN_DOWNLOADER_ENABLED=false
BROWSER_FALLBACK_ENABLED=false
DOUYIN_DOWNLOADER_TIMEOUT_MS=180000

# Optional platform library. Configure a personal library in the desktop library tab.
PLATFORM_FEISHU_APP_ID=
PLATFORM_FEISHU_APP_SECRET=
PLATFORM_FEISHU_BASE_URL=
